RunService:BindToRenderStep("SypherAimbot", Enum.RenderPriority.Camera.Value + 1, function()
    if Config.AimbotEnabled then
        local Camera = workspace.CurrentCamera
        if not Camera then return end
        
        local target = nil
        local shortestDistance = Config.FovRadius
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
                local head = v.Character:FindFirstChild("Head") or v.Character:FindFirstChild("HumanoidRootPart")
                if not head then continue end
                
                -- Безпечний тім чек для Aimbot
                local isTeammate = false
                if Config.TeamCheck then
                    pcall(function()
                        if LocalPlayer.Team and v.Team and LocalPlayer.Team == v.Team then isTeammate = true end
                    end)
                end
                if isTeammate then continue end

                if not Config.AimThroughWalls and not IsVisible(head) then continue end
                
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen and pos.Z > 0 then
                    local mag = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if mag < shortestDistance then
                        shortestDistance = mag
                        target = v
                    end
                end
            end
        end
        
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if head then
                if Config.UseSmoothness then
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, head.Position), math.clamp(Config.Smoothness, 0.05, 1))
                else
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, head.Position)
                end
            end
        end
    end
end)

-- ==========================================
-- РЕНДЕР ESP
-- ==========================================
local hue = 0
RunService.RenderStepped:Connect(function()
    local Camera = workspace.CurrentCamera
    if not Camera or Camera.ViewportSize.Y == 0 then return end

    if not ESPGui.Parent then
        ESPGui.Parent = GetSafeGui()
    end

    hue = hue + 0.005
    if hue > 1 then hue = 0 end
    local rainbowColor = Color3.fromHSV(hue, 1, 1)

    if Config.ShowFov then
        FovCircle.Position = UDim2.new(0, Camera.ViewportSize.X / 2, 0, Camera.ViewportSize.Y / 2)
        FovCircle.Size = UDim2.new(0, Config.FovRadius * 2, 0, Config.FovRadius * 2)
        FovStroke.Color = Config.FovColor
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hum = LocalPlayer.Character.Humanoid
        hum.WalkSpeed = Config.WalkSpeed
        hum.JumpPower = Config.JumpPower
        if Config.AutoJump then hum.Jump = true end
        if Config.AutoWalk then hum:Move(Vector3.new(0, 0, -1), true) end
    end

    for player, esp in pairs(ESP_Elements) do
        local isDrawn = false

        if Config.EspEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            local char = player.Character
            local hrp = char.HumanoidRootPart
            local hum = char.Humanoid
            
            local h = hum.Health
            local maxH = hum.MaxHealth
            if maxH <= 0 then maxH = 100 end 
            
            if h > 0 then
                local distance = (Camera.CFrame.Position - hrp.Position).Magnitude

                -- 100% БЕЗПЕЧНИЙ TEAM CHECK (в обгортці pcall для захисту від крашів)
                local isTeammate = false
                if Config.TeamCheck then
                    pcall(function()
                        if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
                            isTeammate = true
                        end
                    end)
                end

                if distance <= Config.MaxDistance and not isTeammate then
                    local canSee = true
                    if not Config.EspThroughWalls then canSee = IsVisible(hrp) end

                    if canSee then
                        local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                        if hrpPos.Z > 0 then
                            local head = char:FindFirstChild("Head") or hrp
                            local topPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                            local bottomPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

                            local boxHeight, boxWidth, topX, topY

                            if topPos.Z > 0 and bottomPos.Z > 0 then
                                boxHeight = math.abs(bottomPos.Y - topPos.Y)
                                boxWidth = boxHeight * 0.65
                                topX = topPos.X
                                topY = topPos.Y
                            else
                                local dist = hrpPos.Z
                                boxHeight = math.clamp((Camera.ViewportSize.Y / dist) * 4, 10, Camera.ViewportSize.Y * 1.5)
                                boxWidth = boxHeight * 0.65
                                topX = hrpPos.X
                                topY = hrpPos.Y - (boxHeight / 2)
                            end

                            if Config.BoxEnabled then
                                esp.Box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
                                esp.Box.Position = UDim2.new(0, topX - boxWidth / 2, 0, topY)
                                esp.BoxStroke.Color = Config.RainbowBox and rainbowColor or Config.BoxColor
                                esp.Box.Visible = true
                            else esp.Box.Visible = false end

                            if Config.HealthBarEnabled then
                                local hpPercent = math.clamp(h / maxH, 0, 1)
                                
                                esp.HealthBarBG.Size = UDim2.new(0, 4, 0, boxHeight)
                                esp.HealthBarBG.Position = UDim2.new(0, topX - boxWidth / 2 - 7, 0, topY)
                                
                                esp.HealthBar.Size = UDim2.new(1, 0, hpPercent, 0)
                                esp.HealthBar.Position = UDim2.new(0, 0, 1 - hpPercent, 0)
                                esp.HealthBar.BackgroundColor3 = Color3.fromRGB(255 - (hpPercent * 255), hpPercent * 255, 0)
                                
                                esp.HealthText.Text = math.floor(h) .. " HP"
                                esp.HealthText.Position = UDim2.new(0, topX - boxWidth / 2 - 32, 0, topY + boxHeight - (boxHeight * hpPercent) - 6)
                                
                                esp.HealthBarBG.Visible = true
                                esp.HealthText.Visible = true
                            else esp.HealthBarBG.Visible = false; esp.HealthText.Visible = false end

                            if Config.HighlightEnabled then
                                esp.Highlight.Adornee = char
                                esp.Highlight.FillColor = Config.HighlightFillColor
                                esp.Highlight.FillTransparency = Config.HighlightTransparency
                                esp.Highlight.DepthMode = Config.EspThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
                                esp.Highlight.Enabled = true
                            else esp.Highlight.Enabled = false end

                            isDrawn = true
                        end
                    end
                end
            end
        end

        if not isDrawn then
            esp.Box.Visible = false
            esp.HealthBarBG.Visible = false
            esp.HealthText.Visible = false
            esp.Highlight.Enabled = false
        end
    end
end)
