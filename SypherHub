-- ГОЛОВНИЙ ЦИКЛ (Оптимізований)
-- ==========================================
RunService:BindToRenderStep("SypherHub_MainLoop", Enum.RenderPriority.Camera.Value + 1, function()
    -- FOV Коло
    if FOVCircle then
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOVCircle.Radius = Options.FOVRadius
        FOVCircle.Visible = Options.ShowFOV
    end

    -- Аімбот
    if Options.Aimbot then
        local targetHead = getClosestPlayerToCursor()
        if targetHead then
            local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            if Options.SmoothAim then
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Options.Smoothness)
            else
                Camera.CFrame = targetCFrame
            end
        end
    end
    
    -- Підтримка швидкості та стрибка з Tab Player
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("Humanoid") then
        local humanoid = character.Humanoid
        if Options.WalkSpeed ~= 16 then
            humanoid.WalkSpeed = Options.WalkSpeed
        end
        if Options.JumpPower ~= 50 then
            humanoid.JumpPower = Options.JumpPower
        end
    end

    -- ESP Цикл
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character:FindFirstChild("Head") then
            local char = p.Character
            local head = char.Head
            local humanoid = char.Humanoid
            local rootPart = char:FindFirstChild("HumanoidRootPart") or head
            
            local distFromCam = (Camera.CFrame.Position - rootPart.Position).Magnitude
            
            if Options.ESP and distFromCam <= Options.MaxDistance and (not Options.TeamCheck or p.Team ~= LocalPlayer.Team) then
                -- 1. Highlight (Chams)
                local hl = char:FindFirstChild("SypherHighlight")
                if Options.EnableHighlight then
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "SypherHighlight"
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = char
                    end
                    hl.FillColor = Options.HighlightColor
                    hl.OutlineColor = Options.HighlightColor
                    hl.FillTransparency = Options.HighlightTransparency
                    hl.OutlineTransparency = 0
                    hl.Enabled = humanoid.Health > 0
                elseif hl then
                    hl:Destroy()
                end

                -- 2. Name & HP Text
                local bg = head:FindFirstChild("SypherInfo")
                if not bg and Options.NameESP then
                    bg = Instance.new("BillboardGui")
                    bg.Name = "SypherInfo"
                    bg.Size = UDim2.new(0, 120, 0, 30)
                    bg.StudsOffset = Vector3.new(0, 2.5, 0)
                    bg.AlwaysOnTop = true
                    bg.Parent = head
                    
                    local nameLbl = Instance.new("TextLabel", bg)
                    nameLbl.Name = "NameLabel"
                    nameLbl.Size = UDim2.new(1, 0, 1, 0)
                    nameLbl.BackgroundTransparency = 1
                    nameLbl.Font = Enum.Font.GothamBold
                    nameLbl.TextSize = 12
                    nameLbl.TextStrokeTransparency = 0
                end
                
                local nameLbl = bg and bg:FindFirstChild("NameLabel")
                if nameLbl and Options.NameESP then
                    local currentHp = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
                    nameLbl.Text = "[" .. currentHp .. "%] " .. p.Name
                    nameLbl.TextColor3 = Options.BoxColor
                    bg.Enabled = humanoid.Health > 0
                elseif bg then
                    bg.Enabled = false
                end

                -- 3. Box та Healthbar
                local espObj = ESPFolder:FindFirstChild("ESPObj_" .. p.Name)
                if not espObj then
                    espObj = Instance.new("Folder")
                    espObj.Name = "ESPObj_" .. p.Name
                    espObj.Parent = ESPFolder
                    
                    local box = Instance.new("Frame", espObj)
                    box.Name = "Box"
                    box.BorderSizePixel = 0
                    
                    local stroke = Instance.new("UIStroke", box)
                    stroke.Name = "Stroke"
                   
