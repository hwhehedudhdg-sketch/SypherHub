-- Ініціалізація сервісів
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- Завантаження UI бібліотеки Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Налаштування скрипта
local Options = {
    -- Aimbot
    Aimbot = false,
    AimbotSmoothness = 0.5,
    ShowFOV = false,
    FOVSize = 100,
    FOVColor = Color3.fromRGB(255, 255, 255),
    
    -- ESP
    ESP = false,
    ESPBoxes = true,
    ESPSnaplines = false,
    ESPColor = Color3.fromRGB(255, 0, 0),
    
    -- Movement
    AutoJump = false,
    AutoWalk = false,
}

-- Створення вікна UI (Sypher Hub)
local Window = Rayfield:CreateWindow({
    Name = "Sypher Hub | Universal",
    LoadingTitle = "Sypher Hub Initialization",
    LoadingSubtitle = "by Sypher_777",
    ConfigurationSaving = {
        Enabled = false,
        FolderName = "SypherHubConfig",
        FileName = "HubConfig"
    },
    KeySystem = false,
})

-- Вкладка: Combat (Бої)
local CombatTab = Window:CreateTab("Combat", 4483362458)
CombatTab:CreateSection("Aimbot")

CombatTab:CreateToggle({
    Name = "Enable Aimbot",
    CurrentValue = false,
    Callback = function(Value)
        Options.Aimbot = Value
    end,
})

CombatTab:CreateSlider({
    Name = "Smoothness",
    Range = {0.1, 1},
    Increment = 0.1,
    CurrentValue = 0.5,
    Callback = function(Value)
        Options.AimbotSmoothness = Value
    end,
})

-- Вкладка: Visuals (Візуальні функції та ESP)
local VisualsTab = Window:CreateTab("Visuals", 4483362458)
VisualsTab:CreateSection("ESP Налаштування")

VisualsTab:CreateToggle({
    Name = "Enable ESP",
    CurrentValue = false,
    Callback = function(Value)
        Options.ESP = Value
    end,
})

VisualsTab:CreateToggle({
    Name = "ESP Boxes",
    CurrentValue = true,
    Callback = function(Value)
        Options.ESPBoxes = Value
    end,
})

-- Вкладка: Tab Player
local PlayerTab = Window:CreateTab("Tab Player", 4483362458)
PlayerTab:CreateSection("Гравці")

PlayerTab:CreateButton({
    Name = "Оновити список гравців",
    Callback = function()
        Rayfield:Notify({Title = "Tab Player", Content = "Список гравців оновлено!", Duration = 2})
    end,
})

-- Вкладка: Movement (Рух)
local MovementTab = Window:CreateTab("Movement", 4483362458)
MovementTab:CreateSection("Автоматизація руху")

MovementTab:CreateToggle({
    Name = "Auto Jump",
    CurrentValue = false,
    Callback = function(Value)
        Options.AutoJump = Value
    end,
})

MovementTab:CreateToggle({
    Name = "Auto Walk",
    CurrentValue = false,
    Callback = function(Value)
        Options.AutoWalk = Value
    end,
})

-- Вкладка: Info (Інформація)
local InfoTab = Window:CreateTab("Info", 4483362458)
InfoTab:CreateSection("SYPHER HUB v2.0")

InfoTab:CreateParagraph({Title = "Статус", Content = "Добро пожлювати в Sypher Hub!\n\nРазработчик: Sypher_777\nВерсія: 2.0.0\nСтатус: Активний / Працює"})
InfoTab:CreateParagraph({Title = "Що нового у цій версії:", Content = "- Додано Auto Jump та Auto Walk\n- Повністю оновлено Tab Player\n- Покращено роботу Aimbot та ESP"})

                   
