    esp.HealthBarBG.BorderSizePixel = 0
    esp.HealthBarBG.Visible = false
    esp.HealthBarBG.Parent = ESPGui
    
    esp.HealthBar = Instance.new("Frame")
    esp.HealthBar.BorderSizePixel = 0
    esp.HealthBar.Parent = esp.HealthBarBG
    
    esp.HealthText = Instance.new("TextLabel")
    esp.HealthText.BackgroundTransparency = 1
    esp.HealthText.TextSize = 13
    esp.HealthText.Font = Enum.Font.Code
    esp.HealthText.TextColor3 = Color3.fromRGB(255, 255, 255)
    esp.HealthText.TextStrokeTransparency = 0
    esp.HealthText.Visible = false
    esp.HealthText.Parent = ESPGui
    
    esp.Highlight = Instance.new("Highlight")
    esp.Highlight.Enabled = false
    esp.Highlight.Parent = ESPGui
    
    ESP_Elements[player] = esp
end

local function RemoveESP(player)
    if ESP_Elements[player] then
        for _, v in pairs(ESP_Elements[player]) do
            if typeof(v) == "Instance" then v:Destroy() end
        end
        ESP_Elements[player] = nil
    end
end

for _, v in pairs(Players:GetPlayers()) do if v ~= LocalPlayer then CreateESP(v) end end
